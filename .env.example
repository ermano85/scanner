# Copy to .env (which is gitignored) and fill in.
#
# Only API keys belong here. Account size, risk percent, stop buffer and the
# concentration cap live in config/scan.yaml under `sizing:` — one home each, so a
# change cannot be applied in one place and forgotten in the other.

# Financial Modeling Prep — free tier, 250 requests/day.
# https://site.financialmodelingprep.com/developer/docs
# The only free source with a native confirmed-vs-estimated earnings flag. Without it
# pass2 still runs: earnings fall back to Nasdaq plus SEC EDGAR, and no date can be
# reported as `confirmed`.
FMP_API_KEY=

# Sent as the User-Agent to SEC EDGAR, which requires a contact address in the header
# and throttles requests without one. Not a secret; it is published in every request.
SEC_CONTACT_EMAIL=
